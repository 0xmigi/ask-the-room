# --- Model provider for transcription, slide reading and answers ---
# superlinked = Superlinked Serverless (default, free credits at console.superlinked.com)
# darkbloom   = Darkbloom (console.darkbloom.dev)
PROVIDER=superlinked
SIE_API_KEY=sk-sie-REPLACE_ME
DARKBLOOM_API_KEY=eigeninference-REPLACE_ME
# Optional model overrides (defaults per provider are in providers.py)
# TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
# VISION_MODEL=Qwen/Qwen3.8-27B-FP8
# CHAT_MODEL=Qwen/Qwen3.8-27B-FP8

# --- Embeddings: Superlinked SIE running on this machine (see README) ---
SIE_URL=http://localhost:8080
EMBED_MODEL=Snowflake/snowflake-arctic-embed-s
EMBED_DIMS=384

# --- Stream ---
STREAM_URL=https://x.com/i/broadcasts/2BlLYMdAKggbpE

# --- Memory ---
# cognee = Cognee graph memory (default). simple = SIE vectors only (fallback if Cognee misbehaves)
MEMORY=cognee
COGNIFY_EVERY=180
DATASET=room
# Cognee's LLM + embedding settings are filled in from the values above by memory.py.
# Override only if needed, e.g. STRUCTURED_OUTPUT_FRAMEWORK=instructor
