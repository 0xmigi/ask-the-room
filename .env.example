# --- Darkbloom: transcription, vision, answers ---
DARKBLOOM_API_KEY=eigeninference-REPLACE_ME
DARKBLOOM_BASE_URL=https://api.darkbloom.dev/v1
TRANSCRIBE_MODEL=whisper-1
VISION_MODEL=qwen3.6-35b-a3b-vl-mtp-mxfp8
ANSWER_MODEL=gpt-oss-20b

# --- Superlinked SIE: embeddings (local server, see README) ---
SIE_URL=http://localhost:8080
EMBED_MODEL=Snowflake/snowflake-arctic-embed-s
EMBED_DIMS=384

# --- Stream ---
STREAM_URL=https://x.com/i/broadcasts/2BlLYMdAKggbpE

# --- Memory ---
# cognee = Cognee graph memory (default). simple = SIE vectors only (fallback if Cognee misbehaves)
MEMORY=cognee
COGNIFY_EVERY=180
DATASET=room

# Cognee's own LLM + embedding settings are filled in from the values above by memory.py.
# Override here only if you need to, e.g. STRUCTURED_OUTPUT_FRAMEWORK=instructor
